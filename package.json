{
  "name": "fakturace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/migrate.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:check": "node --disable-warning=ExperimentalWarning scripts/schema-diff.mjs --check",
    "db:new-migration": "node --disable-warning=ExperimentalWarning scripts/schema-diff.mjs --create",
    "check": "npm run lint && npm run typecheck && npm run test && npm run db:check"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^12.11.1",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.5.438",
    "pngjs": "^7.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
