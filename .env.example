# Fakturace – vzor konfigurace.
# Zkopírujte do .env (lokálně) nebo zadejte jako proměnné služby na Railway.
# Soubor .env nikdy necommitujte.

# Veřejná adresa aplikace (bez lomítka na konci). Musí sedět s adresou v prohlížeči.
APP_URL=http://localhost:3000

# Kam se ukládá databáze, PDF doklady a účtenky. Na Railway: /data (připojený volume).
DATA_DIR=./data

# Tajný klíč pro podepisování relací (min. 32 znaků).
# Vygenerujte: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Jednorázový instalační kód pro založení jediného účtu (min. 16 znaků).
# Vygenerujte: openssl rand -hex 16
# Po založení účtu ho můžete změnit na jinou náhodnou hodnotu – druhý účet stejně nejde založit.
SETUP_TOKEN=

# --- E-maily (odchozí SMTP Railway Hobby blokuje, proto přes HTTPS) ---
# Doporučeno: odesílání z vašeho Gmailu přes skript Google Apps Script
# (postup v aplikaci: Nastavení → E-maily → Propojení Gmailu).
# GMAIL_RELAY_URL=https://script.google.com/macros/s/…/exec
# Vygenerujte: openssl rand -hex 24
# GMAIL_RELAY_SECRET=
# Adresa Gmailu, ze kterého skript odesílá (jméno se zobrazí příjemci):
# MAIL_FROM=Jan Novák <vas.ucet@gmail.com>
#
# Alternativa s vlastní doménou: Resend (pak MAIL_FROM na ověřené doméně).
# RESEND_API_KEY=

# Volitelné: adresa API registru ARES (výchozí hodnota stačí).
# ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty
